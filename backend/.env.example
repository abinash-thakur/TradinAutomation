# =================================================================
# Backend Environment Configuration - TradePulse AI
# =================================================================

# Server Port
PORT=3000

# Security: Master key for AES-256-GCM encryption of broker API secrets
# IMPORTANT: In production, change this to a secure random 32+ character string!
ENCRYPTION_SECRET=trading-automation-master-secret-key-2026

# =================================================================
# Single-Admin Login (POST /api/auth/login)
# =================================================================
# This app has exactly one operator - there is no user table or signup flow.
# ADMIN_PASSWORD MUST be set or login is refused. JWT_SECRET signs the access token;
# change both to random values in production, and rotate JWT_SECRET to invalidate all sessions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=trading-automation-jwt-dev-secret
JWT_EXPIRES_IN=12h

# Login is now two-step: password, THEN a 6-digit OTP emailed to NOTIFY_EMAIL (see SMTP below).
# POST /api/auth/login (username, password) -> {loginToken}
# POST /api/auth/verify-otp (loginToken, otp) -> {accessToken}
# POST /api/auth/resend-otp (loginToken)
# Login is refused outright if SMTP isn't configured - there is no password-only fallback.

# =================================================================
# Email (SMTP) - OTP delivery + trade notifications
# =================================================================
# Order-placed and square-off emails are sent to NOTIFY_EMAIL; the login OTP goes there too.
# Using Gmail: create an App Password (myaccount.google.com/apppasswords, requires 2FA on the
# account) - a normal Gmail password will NOT work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="TradePulse AI <your-address@gmail.com>"
NOTIFY_EMAIL=your-address@gmail.com

# =================================================================
# Remote PostgreSQL Database Configuration
# =================================================================
# Option A: Full connection URL (e.g. Supabase, Neon, Render, AWS RDS)
# DATABASE_URL=postgresql://user:password@remote-db-host.com:5432/trading_platform?sslmode=require

# Option B: Individual connection parameters
DB_HOST=your-remote-postgres-host.com
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=trading_platform
DB_SSL=false   # Set to true if remote server requires SSL (AWS, Neon, Supabase)

# =================================================================
# Remote Redis Configuration (Real-time Caching & Pub/Sub)
# =================================================================
# Option A: Full Redis URL (e.g. Upstash, Redis Cloud)
# REDIS_URL=redis://default:password@remote-redis-host.com:6379

# Option B: Individual connection parameters
REDIS_HOST=your-remote-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false   # Set to true if remote Redis uses TLS/SSL (e.g. rediss://)

# =================================================================
# Trading Strategy & Broker Defaults
# =================================================================
DEFAULT_TIMEZONE=Asia/Kolkata
DELTA_INDIA_API_URL=https://api.india.delta.exchange
DELTA_GLOBAL_API_URL=https://api.delta.exchange
DELTA_INDIA_TESTNET_URL=https://cdn-ind.testnet.delta.exchange
DELTA_GLOBAL_TESTNET_URL=https://testnet-api.delta.exchange
# '*' (default), a single origin, or a comma-separated list. Must be the full origin the browser
# sends - scheme + host + port, e.g. http://192.168.1.50:5173 - not a bare IP or hostname.
CORS_ORIGIN=*
